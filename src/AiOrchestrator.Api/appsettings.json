{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Orchestrator": {
    "MaxToolIterations": 6,
    "MaxToolResultChars": 8000,
    "ToolCatalogTtlSeconds": 300
  },

  "Llm": {
    "Provider": "Claude",
    "Claude": {
      "BaseUrl": "https://api.anthropic.com/v1/",
      "Model": "claude-sonnet-4-5-20250929",
      "AnthropicVersion": "2023-06-01",
      "ApiKeyEnvironmentVariable": "ANTHROPIC_API_KEY",
      "TimeoutSeconds": 60
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434/",
      "Model": "llama3.2",
      "TimeoutSeconds": 300,
      "NumGpu": 0,
      "NumCtx": 8192,
      "KeepAlive": "30m"
    }
  },

  "Mcp": {
    "StartupTimeoutSeconds": 15,
    "CallTimeoutSeconds": 30,
    "Servers": [
      {
        "Id": "payee",
        "Name": "Payee Service",
        "Command": "dotnet",
        "Args": [ "src/McpServers/PayeeMcpServer/bin/Debug/net8.0/PayeeMcpServer.dll" ],
        "Enabled": true
      },
      {
        "Id": "business-security",
        "Name": "Business Security Service",
        "Command": "dotnet",
        "Args": [ "src/McpServers/BusinessSecurityMcpServer/bin/Debug/net8.0/BusinessSecurityMcpServer.dll" ],
        "Enabled": true
      },
      {
        "Id": "approval-workflow",
        "Name": "Approval Workflow Service",
        "Command": "dotnet",
        "Args": [ "src/McpServers/ApprovalWorkflowMcpServer/bin/Debug/net8.0/ApprovalWorkflowMcpServer.dll" ],
        "Enabled": true
      }
    ]
  }
}
